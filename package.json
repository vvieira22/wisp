{
  "name": "wisp",
  "version": "1.1.1",
  "private": true,
  "description": "Desktop ghost that talks to a local Cursor agent.",
  "author": "vvieira22",
  "repository": {
    "type": "git",
    "url": "https://github.com/vvieira22/wisp.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node src/lib/usage.check.js && node src/lib/pet-state.check.js && node src/lib/markdown.check.js && node src/lib/opencode-providers.check.js && node src/lib/attachments.check.js && node src/lib/logs.check.js && node src/lib/crypto.check.js && node src/lib/i18n.check.js && node src/lib/compat.check.js && node src/lib/chats.check.js && node src/lib/queue.check.js && node src/lib/chat.ui.check.js && node src/lib/files.check.js && node src/lib/folders.check.js && node src/lib/tls.check.js && node src/lib/lan.check.js && node src/lib/mobile-bridge.check.js",
    "compat:release-notes": "node scripts/compat-release-notes.js",
    "release:notes": "node scripts/generate-release-notes.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@cursor/sdk": "^1.2.0",
    "@rive-app/canvas": "^2.42.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "@connectrpc/connect-node": {
      "undici": "^6.28.1"
    }
  },
  "build": {
    "appId": "wisp.ghost",
    "productName": "Wisp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!src/mascot/**",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!src/mascot.preview.gif",
      "!src/mascot.gif",
      "!assets/**",
      "!dist/**",
      "!.superpowers/**",
      "!.claude/**",
      "!.github/**",
      "!docs/**",
      "!scripts/**",
      "!src/lib/*.check.js",
      "!AGENTS.md"
    ],
    "asarUnpack": [
      "node_modules/@cursor/sdk-*/**"
    ],
    "win": {
      "icon": "src/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wisp"
    },
    "mac": {
      "icon": "src/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "src/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vvieira22",
        "repo": "wisp",
        "releaseType": "release"
      }
    ]
  }
}
